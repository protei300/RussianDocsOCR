{
    "Name": "TypesAnglesModel",
    "File": "model.onnx.ir",
    "ModelType": "UnifedModel",
    "Inputs": [
        {
            "Type": "Classification",
            "Name": "image_input",
            "Shape": [
                224,
                224,
                3
            ],
            "Normalization": [
                0,
                1
            ],
            "PaddingSize": [
                0,
                0
            ],
            "PaddingColor": [
                0,
                0,
                0
            ]
        }
    ],
    "Outputs": [
        {
            "Name": "embeddings",
            "Shape": [
                1100
            ],
            "Type": "Metric",
            "Metric": "Cosine",
            "Centers": "resources\\centers.pkl"
        },
        {
            "Name": "angle",
            "Shape": [
                4
            ],
            "Type": "MultiLabelClassification",
            "Labels": [
                0,
                90,
                180,
                270
            ]
        }
    ]
}