<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The web service. One executable serving the REST API and the SPA out of web/dist.

    Microsoft.NET.Sdk.Web, and no package reference for the framework: ASP.NET Core ships with the
    SDK. The service adds exactly ONE dependency beyond what the library already needs — Argon2id
    for named-account passwords, which cannot sensibly be hand-rolled. The JWT still is (Auth/Auth.cs),
    because forty lines of HMAC is cheaper to audit than a package.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      The name matches the Go port's binary, so the two deployments read alike and a compose file
      differs only in the image tag.
    -->
    <AssemblyName>rdocs-service</AssemblyName>
    <RootNamespace>RussianDocs.Service</RootNamespace>

    <!--
      The SPA is SERVED from web/dist at the repository root and never copied into the build: one
      built frontend serves the Python service, the Go service and this one, and a copy would be the
      version that quietly goes stale. Program.cs resolves the directory at startup.
    -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Argon2id for named accounts; see the note in Directory.Packages.props. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The concurrency tests reach two internal seams in Repositories/Users; nothing else does. -->
    <InternalsVisibleTo Include="RussianDocs.Service.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RussianDocs.DocumentProcessing\RussianDocs.DocumentProcessing.csproj" />
  </ItemGroup>

</Project>
